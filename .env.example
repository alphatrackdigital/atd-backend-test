MONGODB_URI=your_mongodb_connection_string_here
MONGODB_DATABASE=alphatrack
JWT_SECRET=your_jwt_secret_here
ADMIN_LOGIN_MAX_FAILURES=5
ADMIN_LOGIN_WINDOW_MINUTES=15

BREVO_API_KEY=your_brevo_api_key_here
BREVO_CONTACT_LIST_ID=8
BREVO_AUDIT_LIST_ID=11
BREVO_NEWSLETTER_LIST_ID=9
BREVO_LIST_ID=10
BREVO_DOI_TEMPLATE_ID=6
BREVO_DOI_REDIRECT_URL=https://alphatrack.digital/newsletter/confirmed
BREVO_MEETING_WEBHOOK_SECRET=your_meeting_webhook_secret_here
BREVO_TRANSACTIONAL_WEBHOOK_SECRET=your_transactional_webhook_secret_here
BREVO_STRATEGY_CALL_LIST_ID=7

# Meta Conversions API
META_PIXEL_ID=your_meta_pixel_id
META_CAPI_ACCESS_TOKEN=your_meta_capi_access_token
# Optional; defaults to v23.0
META_GRAPH_API_VERSION=v23.0
# Temporary: configure only during a controlled Meta Test Events session.
# META_CAPI_TEST_EVENT_CODE=your_test_event_code

# Optional: attribute names to stamp on contacts who explicitly opt in
# BREVO_CONSENT_ATTRIBUTE=CONSENT
# BREVO_CONSENT_TIMESTAMP_ATTRIBUTE=CONSENT_DATE

# GA4 Measurement Protocol for strategy-call bookings
GA4_MEASUREMENT_ID=your_ga4_measurement_id_here
GA4_MEASUREMENT_PROTOCOL_API_SECRET=your_ga4_api_secret_here
# Optional; defaults to meeting_booked
GA4_MEETING_BOOKED_EVENT_NAME=meeting_booked
GA4_MEASUREMENT_PROTOCOL_DEBUG_MODE=false
GA4_BOOKING_PAGE_LOCATION=https://alphatrack.digital/book-a-call

# Comma-separated browser origins allowed to call admin/public APIs.
ALLOWED_ORIGINS=https://alphatrack.digital,https://www.alphatrack.digital,https://alphatrackdigital.netlify.app,https://atd-backend-test.vercel.app,http://localhost:8080
